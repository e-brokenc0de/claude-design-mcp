{
  "mcpServers": {
    "claude-design": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/dist/server.js"],
      "env": {
        "CLAUDE_DESIGN_CDP_PORT": "9222",
        "CLAUDE_DESIGN_CDP_USER_DATA_DIR": "${CLAUDE_PROJECT_DIR:-.}/.auth/cdp-chrome",
        "CLAUDE_DESIGN_STATE_DIR": "${CLAUDE_PROJECT_DIR:-.}/.claude-design-mcp"
      },
      "timeout": 600000
    }
  }
}
