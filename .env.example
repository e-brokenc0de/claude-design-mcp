# --- CDP (real Chrome) backend ---
# The server attaches to a real Chrome over the Chrome DevTools Protocol so
# claude.ai's Cloudflare protection treats it as a genuine browser. Start it
# once with `pnpm run chrome:cdp` and log into claude.ai.

CLAUDE_DESIGN_CDP_PORT=9222
CLAUDE_DESIGN_CDP_HOST=127.0.0.1
# Dedicated profile dir so it never collides with your primary Chrome.
CLAUDE_DESIGN_CDP_USER_DATA_DIR=./.auth/cdp-chrome
# Which profile inside that dir to use.
CLAUDE_DESIGN_CHROME_PROFILE=Default

# Optional overrides:
# CLAUDE_DESIGN_CDP_URL=http://127.0.0.1:9222
# CLAUDE_DESIGN_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Where to cache project metadata (id -> url, name) across stdio calls.
CLAUDE_DESIGN_STATE_DIR=./.claude-design-mcp

# Optional: override base URL.
CLAUDE_DESIGN_BASE_URL=https://claude.ai/design
