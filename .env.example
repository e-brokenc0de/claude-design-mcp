# Path to Playwright persistent browser profile (auth cookies, localStorage, etc.)
# Created on first `pnpm run auth:bootstrap` headed login. Reused headless thereafter.
CLAUDE_DESIGN_PROFILE_DIR=./.auth/profile

# To reuse cookies from your real Google Chrome Default profile, set this to 1.
# Close all regular Chrome windows first; Chrome locks active profiles.
CLAUDE_DESIGN_USE_SYSTEM_CHROME=0
CLAUDE_DESIGN_CHROME_USER_DATA_DIR=~/Library/Application Support/Google/Chrome
CLAUDE_DESIGN_CHROME_CHANNEL=chrome

# Where to cache project metadata (id -> url, name) across stdio calls.
CLAUDE_DESIGN_STATE_DIR=./.claude-design-mcp

# Optional: run Playwright headed for debugging.
CLAUDE_DESIGN_HEADED=0

# Optional: override base URL.
CLAUDE_DESIGN_BASE_URL=https://claude.ai/design
